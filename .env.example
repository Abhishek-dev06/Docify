# All paths are local. Uploaded images are not persisted by API endpoints.
SCREENING_DATABASE_URL=sqlite:///data/screening.db
# Leave unset when tesseract is on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=20
# Writable database directory for hosted runtimes. Docker defaults to /app/data.
# APP_DATA_DIR=C:\path\to\writable\data
# Comma-separated browser origins when frontend and API use different hosts.
# CORS_ALLOWED_ORIGINS=https://docify-beryl.vercel.app
# Set false on an ephemeral host; use a persistent disk/database before setting true.
# AUDIT_PERSISTENT=true
# Optional verified YuNet/SFace model directory (default: project/models).
# FACE_MODEL_DIR=C:\path\to\verified\models
# Optional locally trained U-Net; matching .json manifest must accompany it.
# TAMPER_MODEL_PATH=C:\path\to\tamper_unet.pt
# Optional one-class stamp-trained YOLOv8 ONNX, raw [1,5,N], 640px, NMS disabled.
# STAMP_YOLO_PATH=C:\path\to\stamp.onnx
# STAMP_YOLO_SHA256=publisher_or_locally_verified_sha256
# Separate audit store. Only the explicit /scans/analyze route persists metadata.
# AUDIT_DATABASE_URL=sqlite:///data/audit.db
